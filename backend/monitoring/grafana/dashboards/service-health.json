{
  "title": "Service Health Overview",
  "tags": ["woragis", "health", "services"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "uid": "service-health",
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "type": "stat",
      "title": "Total Services",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "count(count_over_time({job=\"docker\"}[5m]) > 0) by (service)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "blue"}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "type": "stat",
      "title": "Services with Errors",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "count(sum(rate({job=\"docker\", level=\"error\"}[5m])) > 0) by (service))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 2, "color": "red"}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "type": "timeseries",
      "title": "Log Volume by Service",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(rate({job=\"docker\"}[1m])) by (service)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 1
          },
          "unit": "logs/sec"
        }
      }
    },
    {
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "type": "timeseries",
      "title": "Error Rate by Service",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(rate({job=\"docker\", level=\"error\"}[5m])) by (service)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "errors/sec"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "type": "timeseries",
      "title": "Warning Rate by Service",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(rate({job=\"docker\", level=\"warn\"}[5m])) by (service)",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "warnings/sec"
        }
      }
    },
    {
      "id": 6,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "type": "table",
      "title": "Service Status",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "expr": "sum(rate({job=\"docker\"}[5m])) by (service)",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "weekStart": ""
}
