FROM golang:1.24-bookworm AS builder

WORKDIR /build

# Enable automatic toolchain download if needed
ENV GOTOOLCHAIN=auto

COPY go.mod go.sum ./

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /build/bin/translation-worker ./app/cmd/translation-worker

FROM debian:bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/bin/translation-worker /usr/local/bin/translation-worker

ENV APP_ENV=production

CMD ["translation-worker"]

