FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for WeasyPrint and emoji support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src ./src
COPY templates ./templates

# Create output and results directories
RUN mkdir -p /app/output /app/results

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    RESUME_OUTPUT_DIR=/app/output \
    RESULTS_LOG_DIR=/app/results

# Default command - keep container running, can be overridden
CMD ["tail", "-f", "/dev/null"]

