{
  "name": "job-application-worker",
  "version": "1.0.0",
  "description": "Job application automation worker using Playwright",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test-all.js",
    "test:scraping": "node src/test-linkedin-scraping.js",
    "test:cover-letter": "node src/test-cover-letter.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-coverage",
    "test:jest:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-coverage tests/integration/",
    "test:integration:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage tests/integration/"
  },
  "keywords": [
    "playwright",
    "automation",
    "job-application"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "ioredis": "^5.8.2",
    "pg": "^8.11.3",
    "playwright": "^1.40.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jest": "^29.7.0"
  }
}
