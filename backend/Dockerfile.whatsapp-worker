FROM golang:1.24-bookworm AS builder

WORKDIR /build

# Enable automatic toolchain download if needed
ENV GOTOOLCHAIN=auto
# Enable CGO for SQLite support
ENV CGO_ENABLED=1

COPY whatsapp-worker/go.mod whatsapp-worker/go.sum ./

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libsqlite3-dev && \
    rm -rf /var/lib/apt/lists/*

RUN go mod download

COPY whatsapp-worker/ ./

RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /build/bin/whatsapp-worker ./cmd/whatsapp-worker

FROM debian:bookworm-slim AS runtime

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libsqlite3-0 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/bin/whatsapp-worker /usr/local/bin/whatsapp-worker

ENV APP_ENV=production

CMD ["whatsapp-worker"]
